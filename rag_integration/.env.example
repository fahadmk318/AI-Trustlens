# RAG integration - example environment configuration (copy to .env if desired)
# No secrets required: the integration only talks to the local RAG HTTP API
# and the local Ollama daemon.

# LLM model for baseline QA (app.query_model adapter) and claim extraction
# (claimextractor runtime override). UNSET default = qwen3:8b: the deployment
# default for GitHub/deployment environments that can run the 8B model.
# For local testing on modest hardware, run with, e.g.:
#   $env:OLLAMA_MODEL = "qwen3:4b-q4_K_M"
#OLLAMA_MODEL=qwen3:8b

# Base URL of the running RAG evidence-retrieval service (from the RAG repo):
#   default matches the RAG service config: API_HOST=127.0.0.1, API_PORT=8000
RAG_API_BASE_URL=http://127.0.0.1:8000
# HTTP timeouts (seconds)
RAG_API_CONNECT_TIMEOUT=5
RAG_API_READ_TIMEOUT=60
# Retrieval defaults (mirroring the RAG subsystem's own defaults)
RAG_API_TOP_K=5
RAG_API_RETRIEVAL_MODE=hybrid
# Optional metadata filter, e.g. Medical (leave unset/blank for no filter)
#RAG_API_DOMAIN=Medical
# Max claims per /retrieve/batch call (the API hard-caps at 100)
RAG_API_BATCH_MAX_CLAIMS=100
# Set to 1 to enable the claim extractor's optional LLM refinement stage
TRUSTLENS_REFINE_CLAIMS=0
