# =============================================================================
# AI TrustLens — Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# RAG Microservice Connection
RAG_API_BASE_URL=http://127.0.0.1:8000
RAG_API_TIMEOUT=30.0
RAG_API_TOP_K=5

# Verification Engine Configuration
# Modes: deterministic (default, rule-based stance/scoring) | llm | hybrid
TRUSTLENS_ENABLE_VERIFICATION=1
TRUSTLENS_VERIFICATION_MODE=deterministic

# Local Ollama Model
# Model hosted locally via Ollama daemon (defaults to qwen3:8b)
OLLAMA_MODEL=qwen3:8b

# Web Dashboard Server Configuration
TRUSTLENS_HOST=0.0.0.0
TRUSTLENS_PORT=8080
